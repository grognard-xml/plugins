{
  "name": "@ljb/plugin-kanripo-import",
  "version": "0.1.0",
  "private": true,
  "description": "Kanripo clone-and-convert plugin for LJB",
  "ljbPlugin": true,
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "download:gaiji": "node scripts/download-gaiji-data.mjs",
    "build:concordance": "python scripts/build-concordance-data.py",
    "build:metadata": "python3 scripts/build-kanripo-metadata.py",
    "build:skqs-authors": "python3 scripts/build-skqs-author-wikidata.py",
    "intake:skqs-norbert": "python3 scripts/skqs_norbert_intake.py",
    "fetch:ctext": "node scripts/fetch-ctext-parallel.mjs",
    "test:ctext-wiki": "node --test scripts/ctext-wiki-parallel.test.mjs",
    "test:wikisource": "node --test scripts/wikisource-parallel.test.mjs",
    "test:parallel-batch": "node scripts/test-parallel-batch.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3"
  }
}

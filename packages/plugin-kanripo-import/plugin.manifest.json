{
  "manifestVersion": "1.0.0",
  "id": "kanripo-import",
  "name": "Kanripo import",
  "version": "0.1.0",
  "description": "Clone Kanseki Repository (Kanripo) works and convert each juan to project TEI.",
  "author": "Daniel Patrick Morgan",
  "homepage": "https://github.com/grognard/plugins/tree/main/packages/plugin-kanripo-import",
  "license": "GPL-2.0",
  "grognard": {
    "minVersion": "0.1.0"
  },
  "languages": ["zh-hant", "zh-hans", "lzh"],
  "regions": ["east-asia", "china"],
  "languagePrompt": {
    "message": "Kanripo import is available as a plugin. Open Tools → Plugins to enable “Kanripo import”.",
    "documentLanguages": ["zh-hant", "zh-hans", "lzh"]
  },
  "entry": {
    "kind": "hybrid",
    "module": "dist/register.mjs",
    "python": {
      "module": "kanripo_import.grognard_bridge",
      "runtime": "system",
      "runtimePath": "python"
    }
  },
  "contributions": {
    "fileMenu": [
      {
        "id": "import-kanripo",
        "label": "Import from Kanripo…",
        "action": "kanripo-import.open"
      }
    ],
    "toolsMenu": [
      {
        "id": "punctuate-kanripo",
        "label": "Segment and punctuate…",
        "action": "kanripo-import.punctuate"
      },
      {
        "id": "ai-punctuate-kanripo",
        "label": "AI punctuate selection…",
        "action": "kanripo-import.ai-punctuate"
      },
      {
        "id": "purge-punct-kanripo",
        "label": "Purge punctuation…",
        "action": "kanripo-import.purge-punct"
      },
      {
        "id": "reflow-paragraphs-kanripo",
        "label": "Reflow paragraphs…",
        "action": "kanripo-import.reflow-paragraphs"
      }
    ]
  },
  "bundled": [
    "dist/register.mjs",
    "src/register.ts",
    "python",
    "data/krp_works.json",
    "data/gaiji",
    "data/normalize",
    "data/concordance",
    "data/metadata/krp_works_by_id.json",
    "data/metadata/krp_wikidata_by_kr_id.json",
    "data/metadata/manifest.json"
  ]
}

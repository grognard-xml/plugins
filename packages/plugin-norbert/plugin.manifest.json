{
  "manifestVersion": "1.0.0",
  "id": "norbert",
  "name": "Norbert",
  "version": "0.1.0",
  "description": "Premodern Chinese entity tagging with contextual person clues, noble titles, and the Norbert authority pack.",
  "author": "Daniel Patrick Morgan",
  "homepage": "https://github.com/grognard/plugins/tree/main/packages/plugin-norbert",
  "license": "GPL-2.0",
  "grognard": {
    "minVersion": "0.1.0"
  },
  "languages": ["zh-hant", "zh-hans", "lzh"],
  "regions": ["east-asia", "china"],
  "languagePrompt": {
    "message": "Norbert adds Chinese prosopography tools and an authority pack. Open Tools → Plugins to install it.",
    "documentLanguages": ["zh-hant", "zh-hans", "lzh"]
  },
  "entry": {
    "kind": "hybrid",
    "module": "dist/register.mjs",
    "python": {
      "module": "norbert.grognard_bridge",
      "runtime": "bundled",
      "runtimePath": "python"
    }
  },
  "contributions": {
    "toolsMenu": [
      {
        "id": "norbert-settings",
        "label": "Norbert settings…",
        "action": "norbert.open-settings",
        "separatorBefore": true
      }
    ],
    "autoTagging": [
      {
        "id": "norbert-authority-bomb",
        "label": "Tag from Norbert authority pack",
        "description": "Match person names from the compiled Norbert database.",
        "kind": "authority-tag-bomb",
        "defaultEnabled": true,
        "tags": ["persName"]
      },
      {
        "id": "norbert-context-person",
        "label": "Contextual person tagging",
        "description": "Build compound match strings from dynasty, office, place, and name (Norbert person-wrapper logic).",
        "kind": "contextual-disambiguation",
        "defaultEnabled": true,
        "tags": ["persName", "roleName", "placeName"]
      }
    ],
    "authorityPacks": [
      {
        "id": "norbert-persons",
        "label": "Norbert persons",
        "defaultTag": "persName",
        "install": {
          "source": "authoritypacks-release",
          "releaseId": "authority-packs-chinese",
          "manifestPath": "norbert/manifest.json"
        }
      },
      {
        "id": "norbert-person-wrappers",
        "label": "Norbert person wrappers",
        "defaultTag": "persName",
        "install": {
          "source": "authoritypacks-release",
          "releaseId": "authority-packs-chinese",
          "manifestPath": "norbert/manifest.json"
        }
      },
      {
        "id": "norbert-offices",
        "label": "Norbert offices (官名)",
        "defaultTag": "roleName",
        "install": {
          "source": "authoritypacks-release",
          "releaseId": "authority-packs-chinese",
          "manifestPath": "norbert/manifest.json"
        }
      },
      {
        "id": "norbert-wiki-nt",
        "label": "Norbert + Wikipedia noble titles",
        "defaultTag": "persName",
        "install": {
          "source": "bundled",
          "path": "data/wiki-nt-links.ndjson"
        }
      }
    ],
    "settingsSections": [
      {
        "id": "norbert",
        "label": "Norbert",
        "description": "Contextual tagging rules, noble-title patterns, and authority pack options."
      }
    ],
    "disambiguation": [
      {
        "id": "norbert-context-person",
        "label": "Person by dynasty, office, and origin",
        "entityKind": "person",
        "description": "Disambiguate using concatenated context (e.g. 晉 + 秘書監 + 荀勗) before falling back to name-only matches.",
        "usesContextKeys": ["dynasty", "office", "place", "nationality", "compound-string"]
      },
      {
        "id": "norbert-noble-title",
        "label": "Noble title + given name",
        "entityKind": "person",
        "description": "Resolve abbreviated princely titles where only the given name appears in the surface text.",
        "usesContextKeys": ["office", "place", "compound-string"]
      }
    ]
  },
  "dependencies": {
    "plugins": []
  },
  "bundled": [
    "dist/register.mjs",
    "data/surnames.json",
    "data/geo-admin-suffixes.json",
    "data/wiki-nt-links.ndjson",
    "data/wiki-nt-links.json",
    "python"
  ]
}

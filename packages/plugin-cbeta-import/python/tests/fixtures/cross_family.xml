  <text><body>
    <milestone n="1" unit="juan"/>
    <lb n="0001a01" ed="T"/><cb:docNumber>No. 8888</cb:docNumber>
    <lb n="0001a02" ed="T"/><cb:juan n="001" fun="open"><cb:mulu n="1" type="卷"/><cb:jhead>測試密教經卷第一</cb:jhead></cb:juan>
    <cb:div type="xu">
      <cb:mulu level="1" type="序">序品</cb:mulu>
      <p xml:id="p1">爾時世尊入<cb:tt place="inline"><cb:t xml:lang="sa-Sidd">SD</cb:t><cb:t xml:lang="zh-Hant"><cb:yin><cb:zi>吽</cb:zi><cb:sg>引</cb:sg></cb:yin></cb:t></cb:tt>三昧。
      誦<cb:fan><cb:zi>儒</cb:zi><cb:yin><note place="inline">仁祚切</note></cb:yin></cb:fan>字真言。</p>
    </cb:div>
    <cb:mulu level="1" n="1" type="品">第一品</cb:mulu>
    <p xml:id="p2" cb:type="verse">諸法從緣起。</p>
    <cb:mulu level="2" n="1" type="其他">小節</cb:mulu>
    <p xml:id="p3">如來說是因。</p>
    <cb:mulu type="附文" level="1"/>
    <p xml:id="p4">附文內容。</p>
    <cb:juan n="001" fun="close"><cb:jhead>測試密教經卷第一</cb:jhead></cb:juan>

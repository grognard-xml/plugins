  <text>
    <body>
      <milestone n="1" unit="juan"/>
      <pb n="0001a" ed="T" xml:id="T99.9999.0001a"/>
      <lb n="0001a01" ed="T"/><cb:docNumber>No. 9999</cb:docNumber>
      <lb n="0001a02" ed="T"/><cb:juan n="001" fun="open"><cb:mulu n="001" type="卷"/><cb:jhead><title>測試經</title>卷第一</cb:jhead></cb:juan>
      <lb n="0001a03" ed="T"/><p xml:id="p0001a0301" style="margin-left:1em;text-indent:-1em">如是我聞。一時佛在
      <lb n="0001a04" ed="T"/>王舍<anchor xml:id="beg0001001"/>城<anchor xml:id="end0001001"/>中。與大比丘眾<g ref="#CB99999"/>俱。
      <note n="0001001" resp="Taisho" type="orig" place="foot text">城＝域【宋】</note>
      <note n="0001001" resp="CBETA" type="mod">城【大】，域【宋】</note></p>
      <cb:juan n="001" fun="close"><cb:jhead><title>測試經</title>卷第一</cb:jhead></cb:juan>
      <milestone n="2" unit="juan"/>
      <lb n="0002a01" ed="T"/><lb n="0002a01" ed="R138"/><cb:juan n="002" fun="open"><cb:jhead><title>測試經</title>卷第二</cb:jhead></cb:juan>
      <lb n="0002a02" ed="T"/><p xml:id="p0002a0201">爾時世尊告諸比丘。</p>
      <cb:juan n="002" fun="close"><cb:jhead><title>測試經</title>卷第二</cb:jhead></cb:juan>
    </body>
    <back>
      <cb:div type="apparatus">
        <head>校注</head>
        <p><app from="#beg0001001" to="#end0001001"><lem wit="#wit.orig">城</lem><rdg resp="#resp2" wit="#wit1">域</rdg></app></p>
      </cb:div>
    </back>

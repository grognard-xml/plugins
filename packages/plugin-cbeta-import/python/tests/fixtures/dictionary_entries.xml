    <lb n="0001a01" ed="C"/><cb:juan n="1" fun="open"><cb:mulu n="1" type="卷"/><cb:jhead>測試音義卷第一<note place="inline">大乘單本</note></cb:jhead></cb:juan>
    <lb n="0001a02" ed="C"/><cb:div type="other"><cb:mulu type="其他" level="1">上卷</cb:mulu><head>上卷<note place="inline">一名某經</note></head>
    <lb n="0001a03" ed="C"/><entry cb:place="inline"><form>池沼</form><cb:def><p xml:id="pD1" style="margin-left:1em" cb:place="inline">之遶反說文沼池也<note place="inline">注文</note>梵言
    <lb n="0001a04" ed="C"/>池水也。</p></cb:def></entry>
    <lb n="0001a05" ed="C"/><entry><form>門閫</form><cb:def><p xml:id="pD2" cb:place="inline">又作梱同苦本反。</p><p xml:id="pD3" cb:place="inline">三蒼梱門限也。</p></cb:def></entry></cb:div>
    <cb:juan n="1" fun="close"><cb:jhead>測試音義卷第一</cb:jhead></cb:juan>
